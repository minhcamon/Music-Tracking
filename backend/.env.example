# =============================================================================
# Music Tracker — Backend Environment Variables Template
# =============================================================================

# Server Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL + Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/music_tracker?schema=public"

# Security & Encryption (AES-256-GCM Token Encryption)
# 32 bytes (64 hex characters or 32 raw bytes) for token encryption at rest
ENCRYPTION_SECRET="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Application Authentication (JWT)
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Spotify Web API Credentials (Developer Dashboard)
SPOTIFY_CLIENT_ID="your_spotify_client_id_here"
SPOTIFY_CLIENT_SECRET="your_spotify_client_secret_here"
SPOTIFY_REDIRECT_URI="http://localhost:3000/api/v1/provider/spotify/callback"

# Synchronization Engine Defaults
DEFAULT_SYNC_INTERVAL_MINUTES=30
SYNC_OVERLAP_BUFFER_MS=120000
